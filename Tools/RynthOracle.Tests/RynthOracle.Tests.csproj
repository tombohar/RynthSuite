<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for RynthOracle: the bundled lists load, /myquests lines parse (ACE's
    format), the Void tracker reads its chat lines, and every page's display list is accepted
    by the engine's own parser (RynthCore src/RynthCore.Engine/UI/ScriptWindows/DisplayListParser.cs,
    compiled in from the sibling RynthCore checkout) within the engine's limits. Clicks are fed
    back as engine events. Nothing native is loaded: no AC, no ImGui context.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RynthOracle.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginCore\RynthCore.PluginCore.csproj" />
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginSdk\RynthCore.PluginSdk.csproj" />
    <!-- The engine parser's whitelists use ImGui.NET's enums. -->
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\**\*.cs" Exclude="..\..\Plugins\RynthCore.Plugin.RynthOracle\obj\**;..\..\Plugins\RynthCore.Plugin.RynthOracle\bin\**" Link="RynthOracle\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthAi\Combat\FellowshipTracker.cs" Link="RynthOracle\Shared\FellowshipTracker.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthAi\RynthClock.cs" Link="RynthOracle\Shared\RynthClock.cs" />
    <Compile Include="..\..\Plugins\Shared\RynthAiHubApi.cs" Link="RynthOracle\Shared\RynthAiHubApi.cs" />
    <Compile Include="..\..\Plugins\Shared\RynthAiSessionClient.cs" Link="RynthOracle\Shared\RynthAiSessionClient.cs" />
    <!-- RynthCore's server list and the owner plugin's profile (as in the plugin's csproj). -->
    <Compile Include="..\..\Plugins\Shared\RynthServerProfileApi.cs" Link="RynthOracle\Shared\RynthServerProfileApi.cs" />
    <Compile Include="..\..\Plugins\Shared\EngineServerState.cs" Link="RynthOracle\Shared\EngineServerState.cs" />
    <Compile Include="..\..\Plugins\Shared\ServerStateClient.cs" Link="RynthOracle\Shared\ServerStateClient.cs" />
    <!-- "RynthServer.QuestPack": the active server plugin's quest pack (as in the plugin's csproj). -->
    <Compile Include="..\..\Plugins\Shared\RynthServerQuestPackApi.cs" Link="RynthOracle\Shared\RynthServerQuestPackApi.cs" />
    <Compile Include="..\..\Plugins\Shared\ServerQuestPackClient.cs" Link="RynthOracle\Shared\ServerQuestPackClient.cs" />
    <Compile Include="..\..\Plugins\Shared\CommandReply.cs" Link="RynthOracle\Shared\CommandReply.cs" />
    <Compile Include="..\..\..\RynthCore\src\RynthCore.Engine\UI\ScriptWindows\DisplayListParser.cs" Link="Engine\DisplayListParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\Resources\quests.csv" LogicalName="RynthOracle.quests.csv" />
    <!-- Server plugins' quest packs as test data: what RynthConquest, RynthLevistras and RynthAelrynth
         (RynthServers) offered through "RynthServer.QuestPack" on 2026-10-21, frozen here so these tests
         need no RynthServers checkout (TestPacks in QuestPackTests.cs). Never shipped. -->
    <EmbeddedResource Include="TestData\quests.conquest.csv" LogicalName="TestPack.conquest.csv" />
    <EmbeddedResource Include="TestData\quests.levistras.csv" LogicalName="TestPack.levistras.csv" />
    <EmbeddedResource Include="TestData\quests.aelrynth.csv" LogicalName="TestPack.aelrynth.csv" />
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\Resources\augmentations.csv" LogicalName="RynthOracle.augmentations.csv" />
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\Resources\augquests.csv" LogicalName="RynthOracle.augquests.csv" />
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\Resources\society.csv" LogicalName="RynthOracle.society.csv" />
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\Resources\titles.csv" LogicalName="RynthOracle.titles.csv" />
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\Resources\markers.csv" LogicalName="RynthOracle.markers.csv" />
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthOracle\Resources\legendary.csv" LogicalName="RynthOracle.legendary.csv" />
    <EmbeddedResource Include="..\..\Plugins\RynthCore.Plugin.RynthAi\Combat\SpellData.txt" LogicalName="RynthOracle.SpellData.txt" />
  </ItemGroup>

</Project>
