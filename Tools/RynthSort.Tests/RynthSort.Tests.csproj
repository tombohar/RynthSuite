<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for RynthSort: rule matching, pack choice (a full pack only takes an item that
    joins a stack there), Tidy / Clean / Unpack planning, the "stay out of the way" gates (looting,
    vendor, trade, busy, portal space and RynthAi's activity bits), one move at a time with the
    gap and the back-off after refusals, the per-character file and the Lua script import, rules
    tied to pack ids (and the one-time fix of the Lua script's pack numbers, which counted foci),
    rules with several classes and names (and old files migrating to them), the order inside
    packs (every order of up to 7 items, shuffled packs to 102), slot orders and the pack column,
    stacks joined in place, that a fixed inventory runs out of moves (planner and loop),
    the pack picker's labels, spell component classification, and that
    the window's display list is accepted by the engine's own parser (RynthCore
    src/RynthCore.Engine/UI/ScriptWindows/DisplayListParser.cs, compiled in from the sibling
    RynthCore checkout). Nothing native is loaded: no AC, no ImGui context. Files go to a temp
    folder, never C:\Games.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RynthSort.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginCore\RynthCore.PluginCore.csproj" />
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginSdk\RynthCore.PluginSdk.csproj" />
    <!-- The engine parser's whitelists use ImGui.NET's enums. -->
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthSort\**\*.cs" Exclude="..\..\Plugins\RynthCore.Plugin.RynthSort\obj\**;..\..\Plugins\RynthCore.Plugin.RynthSort\bin\**" Link="RynthSort\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Plugins\Shared\RynthAiActivityApi.cs" Link="Shared\RynthAiActivityApi.cs" />
    <Compile Include="..\..\Plugins\Shared\RynthAiStatusApi.cs" Link="Shared\RynthAiStatusApi.cs" />
    <Compile Include="..\..\Plugins\Shared\RynthInstallPaths.cs" Link="Shared\RynthInstallPaths.cs" />
    <Compile Include="..\..\Plugins\Shared\CommandReply.cs" Link="Shared\CommandReply.cs" />
    <Compile Include="..\..\..\RynthCore\src\RynthCore.Engine\UI\ScriptWindows\DisplayListParser.cs" Link="Engine\DisplayListParser.cs" />
  </ItemGroup>

</Project>
