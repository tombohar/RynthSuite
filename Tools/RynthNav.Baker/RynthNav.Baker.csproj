<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RynthNav.Baker</RootNamespace>
    <AssemblyName>RynthNav.Baker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared AC terrain reader (DatDatabase, LandblockData, TerrainSampler) -->
    <ProjectReference Include="..\..\Shared\RynthCore.TerrainData\RynthCore.TerrainData.csproj" />
    <!-- AC static/scatter/dungeon geometry reader (GeometryLoader, namespace RynthCore2.Raycast).
         OutputType=Exe + Silk.NET deps come along; acceptable for an offline baker. -->
    <ProjectReference Include="..\..\..\AcClientReborn\landblock\AcClientReborn.Landblock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The coarse route graph (graph mode): same region numbering and file format as the plugin. -->
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\NavRegions.cs" Link="Shared\NavRegions.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\NavGraph.cs" Link="Shared\NavGraph.cs" />
    <!-- A dungeon's tiles in one file (dun_LLLL.tile), the same code the plugin reads it with. -->
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\DungeonTileFile.cs" Link="Shared\DungeonTileFile.cs" />
    <!-- Portal avoidance exactly as the plugin plans with it (the portal-reach items of the check mode). -->
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\PortalAvoid.cs" Link="Shared\PortalAvoid.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\AvoidFilter.cs" Link="Shared\AvoidFilter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recast/Detour navmesh stack (offline bake uses Recast; runtime plugin will use Detour) -->
    <PackageReference Include="DotRecast.Core" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast.Toolset" Version="2026.1.3" />
  </ItemGroup>

</Project>
