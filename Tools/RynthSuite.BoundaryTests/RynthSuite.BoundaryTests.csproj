<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The layer boundary (the owner's rule, 2026-10-21; CLAUDE.md / CONTRIBUTING.md), checked over
    this repository's sources: RynthSuite's plugins name no game server and send no server's own
    commands, no project here is a server plugin, and none links a server-only file. Server plugins
    live in RynthServers. Reads files only; references nothing.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RynthSuite.BoundaryTests</RootNamespace>
  </PropertyGroup>

</Project>
