<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for RynthAi's AutoVendor pure logic (rule judging, buy-up-to-N math,
    batch planning, stack splits). The plugin itself is a NativeAOT x86 library, so the
    two dependency-free source files are compiled in here directly instead of
    referencing the plugin project.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>RynthCore.AutoVendorTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\RynthCore.LootSdk\RynthCore.LootSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthAi\Vendor\AutoVendorRules.cs" Link="Linked\AutoVendorRules.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthAi\Vendor\AutoVendorPlanner.cs" Link="Linked\AutoVendorPlanner.cs" />
  </ItemGroup>

</Project>
