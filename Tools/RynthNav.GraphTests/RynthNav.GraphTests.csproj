<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline tests for RynthNav's long-range route graph: region building (NavRegions), the
    baker's portal matching and costs (GraphBuild), the file format and A* (NavGraph) and the
    route follower (NavCoarse). Tiles are baked here from small made-up floors with the same
    Recast settings as the baker, written to %TEMP%, and removed afterwards.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RynthNav.GraphTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\NavRegions.cs" Link="Linked\NavRegions.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\NavGraph.cs" Link="Linked\NavGraph.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\NavCoarse.cs" Link="Linked\NavCoarse.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\PortalAvoid.cs" Link="Linked\PortalAvoid.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\AvoidFilter.cs" Link="Linked\AvoidFilter.cs" />
    <!-- The navmesh drawn in the world (green floor, red walls) and the sink it writes to. -->
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\NavMeshView.cs" Link="Linked\NavMeshView.cs" />
    <Compile Include="..\..\Plugins\Shared\Nav3DText.cs" Link="Linked\Nav3DText.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\DungeonTileFile.cs" Link="Linked\DungeonTileFile.cs" />
    <Compile Include="..\RynthNav.Baker\GraphBuild.cs" Link="Linked\GraphBuild.cs" />
    <!-- A planned trip's walk from the tile files (TilePathFinder) and what it needs. -->
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\TilePathFinder.cs" Link="Linked\TilePathFinder.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\TripPlan.cs" Link="Linked\TripPlan.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\TripPath.cs" Link="Linked\TripPath.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\NavCoords.cs" Link="Linked\NavCoords.cs" />
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthNav\TownNet.cs" Link="Linked\TownNet.cs" />
    <Compile Include="..\RynthNav.PortalGraph\PortalRoute.cs" Link="Linked\PortalRoute.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotRecast.Core" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast.Toolset" Version="2026.1.3" />
  </ItemGroup>

</Project>
