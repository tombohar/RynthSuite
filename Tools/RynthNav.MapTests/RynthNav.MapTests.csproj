<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the World Map's compressed tiles (the baker's Dxt1.cs, compiled in): the block
    layout and sizes, the four-colour mode (never the transparent one), that solid and two-colour blocks
    survive, and how close gradients and noisy textures come back through the standard DXT1 decode.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RynthNav.MapTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RynthNav.Baker\Dxt1.cs" Link="Linked\Dxt1.cs" />
  </ItemGroup>

</Project>
